# InfraDrishti Frontend — Environment Variables
# Copy to .env.local and fill in values. Never commit .env.local.
# Only VITE_SUPABASE_PUBLISHABLE_KEY (anon/publishable) goes here.
# The Supabase service-role/secret key belongs ONLY in backend/.env.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
